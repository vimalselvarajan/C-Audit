# Local environment
.venv/

# Local secrets. `.env` holds the Gemini API key and is loaded into the shell by
# tools/load-env.sh -- caudit itself never reads it (my_docs/guides/setup.md section 5).
# It is the one untrackable path `make clean` must never delete: everything else
# in UNTRACKABLE is regenerated by the next run, and this cannot be regenerated
# at all. `.env.example` is a different filename, so it stays tracked with no
# negation here; keep the spelling identical in the Makefile's UNTRACKABLE and
# in the `no-committed-secrets` pre-commit hook.
.env

# Reference clones. Each is an independent clone with its own .git and upstream
# remote (see CLAUDE.md); tracking them turns the working copies into nested
# repositories. They were committed as gitlinks with no .gitmodules until
# 2026-08-14, which made `git submodule status` fail outright.
inspiration_repos/

# User-controlled repositories being audited. These are independent checkouts,
# not source or generated output owned by this repository.
audit-targets/

# Python bytecode and packaging output
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Test, type, lint and coverage caches (`make clean` removes these)
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# caudit run output: the default `--out`/`--workspace` of one command each --
# scan, eval, pairs, ablate, calibrate. All are regenerated per run, and
# run-manifest.json carries a wall-clock timestamp. `caudit-pairs/` also holds
# full checkouts of every pinned pair, which are upstream repositories with
# their own .git and must never be tracked here.
caudit-report/
caudit-eval/
caudit-pairs/
caudit-ablation/
caudit-calibration/
